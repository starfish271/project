---
/**
 * admin.astro — Sveltia CMS entry point.
 *
 * Sveltia CMS is a drop-in replacement for Decap/Netlify CMS that loads
 * from a CDN. It reads/writes files in the GitHub repo via the GitHub API
 * using a personal access token.
 *
 * The CMS config is at /admin/config.yml (see public/admin/config.yml).
 */
import { getCollection } from 'astro:content';

const settingsEntry = await getCollection('settings');
const siteName = settingsEntry[0]?.data?.name ?? 'Admin';
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin — {siteName}</title>
  <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  <!-- Sveltia CMS — loaded from CDN (is:inline prevents Astro from bundling it) -->
  <script is:inline src="https://unpkg.com/@sveltia/cms/dist/sveltia-cms.js"></script>
</head>
<body>
  <!-- Sveltia CMS mounts here automatically -->
</body>
</html>
