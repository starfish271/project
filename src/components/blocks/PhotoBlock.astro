---
/**
 * PhotoBlock — single image with optional caption and width control.
 * Width options: normal (reading width), wide (page width), full-bleed (viewport edge).
 */
interface Props {
  image: string;
  alt: string;
  caption?: string;
  width?: 'normal' | 'wide' | 'full-bleed';
}

const { image, alt, caption, width = 'normal' } = Astro.props;
const base = import.meta.env.BASE_URL;
// Normalize image path with base prefix
const src = image.startsWith('http') ? image : `${base}/${image.replace(/^\//, '')}`;
---

<div class:list={["block-photo", `width-${width}`]} data-block="photo" data-fade-in>
  <figure>
    <img src={src} alt={alt} loading="lazy" />
    {caption && <figcaption class="mono">{caption}</figcaption>}
  </figure>
</div>

<style>
  .block-photo {
    margin: var(--space-3) 0;
  }
  .block-photo figure {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .block-photo img {
    width: 100%;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .block-photo figcaption {
    text-align: center;
    font-size: 0.78rem;
  }

  /* Width variants */
  .width-normal {
    max-width: var(--reading-width);
    margin-left: auto;
    margin-right: auto;
    padding: 0 var(--space-3);
  }
  .width-wide {
    max-width: var(--max-width);
    margin-left: auto;
    margin-right: auto;
    padding: 0 var(--space-3);
  }
  .width-full-bleed {
    width: 100vw;
    margin-left: calc(50% - 50vw);
  }
  .width-full-bleed img {
    border-radius: 0;
  }
</style>
